# Application (HTTPS required in production)
NEXT_PUBLIC_APP_NAME="MyKontrakans"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Jakarta"

# Neon PostgreSQL; pooled connection is supported
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Optional direct connection for CLI migrations
DIRECT_URL=""

# Auth uses random opaque 256-bit database sessions, not signed JWTs.
# AUTH_SECRET / SESSION_SECRET are not required by this implementation.

# Resend: verify your sender domain before inviting members
RESEND_API_KEY=""
EMAIL_FROM="MyKontrakans <noreply@your-domain.com>"

# Vercel Blob: uploads use public URLs so images can be displayed directly
BLOB_READ_WRITE_TOKEN=""

# Optional initial administrator. Leave empty to skip user seed.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Admin MyKontrakans"
